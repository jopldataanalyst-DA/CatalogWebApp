# Same Postgres database PricingManagementSystem uses (read-only access).
# When deployed as its own Dokploy app, this app lands on `dokploy-network` -
# the same Docker network the `supabase-db` container is directly attached
# to - so its container DNS name + real Postgres port work directly.
DB_HOST=supabase-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# Local development only: the DB above isn't reachable directly off the
# Dokploy/VPS network, so open an SSH tunnel instead. Leave false/unset
# when this app is deployed alongside PricingManagementSystem.
USE_SSH_TUNNEL=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
