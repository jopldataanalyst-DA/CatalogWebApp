# Same Postgres database PricingManagementSystem uses (read-only access).
# When deployed as its own Dokploy app (same as PricingManagementSystem's own
# Dokploy env vars), reach Supabase via the host-gateway port it exposes.
DB_HOST=172.16.1.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# Local development only: the DB above isn't reachable directly off the
# Dokploy/VPS network, so open an SSH tunnel instead. Leave false/unset
# when this app is deployed alongside PricingManagementSystem.
USE_SSH_TUNNEL=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
